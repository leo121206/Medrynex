# ── Medrynx Backend — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development           # development | production | test
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medrynx_db?schema=public
# Render.com free-tier example:
# DATABASE_URL=postgresql://medrynx_user:PASSWORD@dpg-XXXXX-a.oregon-postgres.render.com/medrynx_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# REQUIRED in production — minimum 32 characters, high entropy
JWT_SECRET=replace_this_with_a_64_char_random_string_in_production
JWT_EXPIRES_IN=7d

# ── Encryption ────────────────────────────────────────────────────────────────
# 64-character hex string = 256-bit AES key
# Generate: openssl rand -hex 32
AES_SECRET_KEY=replace_with_64_char_hex_key_in_production_do_not_use_default

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# In production, also set FRONTEND_URL to the deployed frontend domain:
# FRONTEND_URL=https://medrynx.vercel.app

# ── IPFS / Content Storage ────────────────────────────────────────────────────
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
# Set to true when a real Kubo node is not available (free tier)
IPFS_MOCK_ENABLED=true

# ── Blockchain ────────────────────────────────────────────────────────────────
# Hardhat local node (development only)
GANACHE_RPC_URL=http://127.0.0.1:8545
# WARNING: Never use Hardhat well-known keys in production
DEPLOYER_PRIVATE_KEY=
CONTRACT_ADDRESS=

# ── AI/ML Advisory Service ────────────────────────────────────────────────────
# FastAPI service running separately (python ai_service/main.py)
ML_SCORING_URL=http://localhost:8000/predict
ANOMALY_THRESHOLD=65

# ── Internal Services ─────────────────────────────────────────────────────────
# Must be changed in production — used for service-to-service auth
INTERNAL_SERVICE_KEY=replace_with_unique_service_key_in_production

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=20
REQUEST_TIMEOUT_MS=15000

# ── Production Enforcement ───────────────────────────────────────────────────
# Set to "true" to hard-fail startup if any production invariant is violated
STRICT_PROD_ENFORCE=false
