# ── Medrynx Frontend — Environment Variables ──────────────────────────────────
# Copy to .env.local for development, .env.production for production builds.
# Only VITE_* prefixed variables are exposed to the browser bundle.
# NEVER put secrets (JWT keys, DB passwords) in frontend env files.

# ── API Base URL ──────────────────────────────────────────────────────────────
# Leave empty in development — the Vite dev server proxies /api to localhost:5000
VITE_API_BASE_URL=

# Production example (Render.com free backend):
# VITE_API_BASE_URL=https://medrynx-api.onrender.com/api/v1

# ── App Metadata (optional) ───────────────────────────────────────────────────
VITE_APP_NAME=Medrynx
VITE_APP_VERSION=1.0.0
