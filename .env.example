# ==============================================================================
# MEDRYNX PLATFORM ROOT ENVIRONMENT TEMPLATE (.env.example)
# DO NOT COMMIT REAL CREDENTIALS OR KEYS TO VERSION CONTROL
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=<DB_USER>
POSTGRES_PASSWORD=<DB_PASSWORD>
POSTGRES_DB=medrynx_db
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>?schema=public

# Backend API
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=<MIN_32_CHAR_RANDOM_SECRET>
JWT_EXPIRES_IN=7d

# Key Management Service (KMS) & Envelope Encryption
KMS_PROVIDER=local
AES_SECRET_KEY=<64_HEX_CHAR_KEK>
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=<AWS_KMS_KEY_ARN>
AWS_ACCESS_KEY_ID=<AWS_IAM_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_IAM_SECRET_ACCESS_KEY>

# Decentralized Storage (IPFS)
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080/ipfs/
IPFS_MOCK_ENABLED=false

# Blockchain EVM
GANACHE_RPC_URL=http://localhost:8545
CONTRACT_ADDRESS=<DEPLOYED_ACCESS_REGISTRY_ADDRESS>
DEPLOYER_PRIVATE_KEY=<EVM_PRIVATE_KEY>

# AI/ML Anomaly Scoring Microservice
ML_SCORING_URL=http://localhost:8000/predict
ANOMALY_THRESHOLD=65

# Frontend
VITE_API_URL=http://localhost:5000/api/v1
